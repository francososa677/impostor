# Impostor Environment Configuration

# Server Environment
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# CORS & Client URLs
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Public Application URL (Used for QR code and deep links)
PUBLIC_APP_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Optional Secret Token for ephemeral signatures
SESSION_SECRET=impostor-ephemeral-dev-secret-key-change-in-prod
